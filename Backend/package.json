{
  "name": "product-catalogue-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API: serves product data to the web app and emails enquiries to the sales inbox.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
