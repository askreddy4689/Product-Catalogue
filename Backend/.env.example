# Backend settings.
# Copy this file to ".env" in the same folder (Backend/.env) and fill in the values.
# .env is ignored by git, so passwords in it stay on your machine.

# ---------------------------------------------------------------- Web server
PORT=4000
# Address of the website. Used for the product link in enquiry emails.
WEB_APP_URL=http://localhost:5173

# ---------------------------------------------------------------- Product data
FAKE_STORE_API_URL=https://fakestoreapi.com
# Fake Store prices have no currency, so we choose one (3-letter code: GBP, USD, EUR...)
PRICE_CURRENCY=GBP
# How many products to show as "Top rated" on each category page
TOP_RATED_COUNT=5

# ---------------------------------------------------------------- Email (sent through Gmail)
# Inbox that receives enquiries
SALES_INBOX_EMAIL=sales@example.com
# The Gmail account that sends the emails, and its "app password"
# (Google Account → Security → 2-Step Verification → App passwords; not your normal password)
SMTP_USER=
SMTP_PASSWORD=
# Optional: sender shown on emails. Defaults to SMTP_USER (Gmail requires your own address).
# EMAIL_FROM="Product Catalogue <you@gmail.com>"
# Optional: folder with the email template (enquiryToSales.json). Relative paths count from the Backend folder.
# EMAIL_TEMPLATES_DIR=../DataStore/emailTemplates

